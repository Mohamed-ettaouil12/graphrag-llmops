!data/processed/.gitkeep

# Models & Checkpoints (large files)
*.pt
*.pth
*.safetensors
*.bin
checkpoints/

# MLflow
mlruns/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Environment
.env
.env.local
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
*.out

# Temporary
tmp/
temp/
*.tmpcheckpoints/
data/
*.log
.env
mlruns/

# LLMOps (P01) — contenu expérimental non versionné,
# seule l'arborescence (.gitkeep) est suivie.
# NB : reports/j*.md legacy déjà trackés restent trackés (gitignore ne les détache pas).
# P03 : eval/datasets est explicitement suivi (dataset doré gelé + sha256).
eval/*
!eval/.gitkeep
!eval/datasets
ops/*
!ops/.gitkeep
prompts/*
!prompts/.gitkeep
reports/*
!reports/.gitkeep
