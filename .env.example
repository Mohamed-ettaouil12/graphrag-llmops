# LLMOps — variables d'environnement. Copier vers .env (jamais commité).

# --- LLM hébergé (réservé au futur router llmops/router.py).
# Aujourd'hui le pipeline appelle UNIQUEMENT le modèle local Qwen2.5-1.5B-4bit
# (src/llm/load_llm.py) : aucune clé API n'est nécessaire en P01.
MISTRAL_API_KEY=

# --- Tracing / observabilité (Langfuse) — brancheables sur les 7 nœuds
# de l'orchestrateur (src/orchestrator/nodes.py) sans toucher au pipeline.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Neo4j (déjà lu par docker-compose.yml ; à externaliser plus tard
# dans PipelineConfig, src/orchestrator/state.py:68)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword
